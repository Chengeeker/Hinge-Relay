{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hinge-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "hinge-relay"
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "vars": {
    "RELAY_VERSION": "1.0.0",
    "DEFAULT_TTL_HOURS": "168"
  }
}
